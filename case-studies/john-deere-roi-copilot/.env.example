# John Deere Operations Center API — developer.deere.com application profile
# Register http://localhost:9090/callback as a Redirect URI before running the spike.
DEERE_CLIENT_ID=
DEERE_CLIENT_SECRET=

# Sandbox by default. Production: https://api.deere.com/platform
DEERE_BASE_URL=https://sandboxapi.deere.com/platform

# USDA NASS Quick Stats — free key: https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# Anthropic — powers the scenario Q&A panel
ANTHROPIC_API_KEY=
